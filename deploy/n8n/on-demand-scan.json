{
  "name": "Packmon On Demand Scan",
  "active": false,
  "settings": {},
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 260],
      "parameters": {
        "httpMethod": "POST",
        "path": "packmon/scan",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "replace-with-packmon-webhook-header-auth",
          "name": "Packmon On-Demand Webhook Header Auth"
        }
      }
    },
    {
      "id": "run-scan",
      "name": "Run Scan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [540, 260],
      "parameters": {
        "command": "case \"${PACKMON_API_KEY:-}\" in \"\") echo \"PACKMON_API_KEY must be set in the n8n environment\" >&2; exit 1 ;; esac\ncase \"$PACKMON_SERVER\" in \"\") echo \"PACKMON_SERVER must be set in the n8n environment\" >&2; exit 1 ;; esac\ncase \"$PACKMON_SCAN_PATH\" in \"\"|/*|-*|*..*) echo \"PACKMON_SCAN_PATH must be a non-empty relative path without parent traversal or leading dash\" >&2; exit 1 ;; esac\npackmon scan \"$PACKMON_SCAN_PATH\" --mode remote --require-remote --server \"$PACKMON_SERVER\""
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [820, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"workflow\":\"on-demand-scan\",\"status\":\"completed\"}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Run Scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Scan": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
