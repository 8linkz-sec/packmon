# Packmon Local Docker Environment
# The local stack helper copies this file to .env and fills the required local
# secrets when they are missing. Review and rotate those generated values before
# shared or production use.

# --- Local Docker Build Metadata ---
# Optional: Compose forwards these as Docker build args so binaries inside the
# image report traceable metadata from `packmon-server version` and `/version`.
PACKMON_VERSION=dev
PACKMON_COMMIT=none
PACKMON_BUILD_DATE=unknown
# Optional: override these with digest-pinned images mirrored into an internal
# registry. Keep the @sha256 digest in every override.
PACKMON_GO_BUILDER_IMAGE=golang:1.26.4-alpine@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648
PACKMON_ALPINE_RUNTIME_IMAGE=alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
PACKMON_POSTGRES_IMAGE=cgr.dev/chainguard/postgres:18@sha256:891139a6d9036632791857fb7585425f1bf0c64516fc52bc39da94305ee92461

# --- PostgreSQL Container ---
POSTGRES_DB=packmon
POSTGRES_USER=packmon
# Filled by docker compose run --rm init-secrets for local-only first start.
POSTGRES_PASSWORD=

# --- Packmon Server ---
PACKMON_SERVER_MODE=production
PACKMON_SERVER_PORT=8080
PACKMON_SERVER_PUBLIC_HOST=localhost:8080
# PACKMON_TLS_CERT_FILE=/etc/packmon/tls.crt
# PACKMON_TLS_KEY_FILE=/etc/packmon/tls.key
# PACKMON_TLS_MIN_VERSION=1.2
# Local Docker only: compose binds the configured server port to 127.0.0.1. The
# explicit container bind mode keeps the app reachable through that Docker port
# mapping.
# Disable both local HTTP settings and configure TLS or a TLS-terminating
# reverse proxy for shared deployments.
PACKMON_ALLOW_INSECURE_LOCAL_HTTP=true
PACKMON_INSECURE_LOCAL_HTTP_BIND_MODE=container
# Fail-closed transport policy: in production the server refuses to start
# unless ONE of these is set -- in-app TLS (PACKMON_TLS_CERT_FILE +
# PACKMON_TLS_KEY_FILE), a trusted TLS-terminating proxy (PACKMON_TRUSTED_PROXIES),
# or the local-only override above. Comma-separated IPs/CIDRs of trusted proxies:
# PACKMON_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# Local Docker only: listen on the container interface so Compose's host
# loopback port publishing can reach the metrics listener.
PACKMON_METRICS_HOST=0.0.0.0
PACKMON_METRICS_PORT=9090
PACKMON_SERVER_READ_TIMEOUT=30s
PACKMON_SERVER_WRITE_TIMEOUT=30s
PACKMON_SERVER_SHUTDOWN_TIMEOUT=15s
PACKMON_BLOCK_THRESHOLD=CRITICAL
PACKMON_RATE_LIMIT_PER_MINUTE=120
PACKMON_RATE_LIMIT_BURST=60

# --- Web UI Links ---
# PACKMON_WEB_PRIVACY_URL=/privacy
# PACKMON_WEB_LEGAL_URL=
# PACKMON_WEB_TERMS_URL=/terms

# --- Database Connection ---
PACKMON_DB_HOST=postgres
PACKMON_DB_PORT=5432
PACKMON_DB_NAME=packmon
PACKMON_DB_USER=packmon
# Filled by docker compose run --rm init-secrets for local-only first start; normally
# matches POSTGRES_PASSWORD for the bundled local PostgreSQL container.
PACKMON_DB_PASSWORD=
# Local Docker only: the bundled Postgres container is reached on the Compose
# network without database TLS. The built-in production default is `verify-full`;
# keep that default for shared deployments and configure database trust roots
# in the runtime environment.
PACKMON_DB_SSLMODE=disable
# Set either value to 0 to leave that pgx pool setting at its default.
# PACKMON_DB_MAX_CONNS=20
# PACKMON_DB_MIN_CONNS=2
# Bounds startup DB checks and explicit migration DB operations.
PACKMON_DB_CONNECT_TIMEOUT=10s

# --- Backups ---
# Local target for the manual `docker compose run --rm packmon-backup` job.
# Keep this path outside source control for shared or production deployments.
PACKMON_BACKUP_DIR=./backups

# --- Logging ---
PACKMON_LOG_LEVEL=info
PACKMON_LOG_FORMAT=json

# --- Admin ---
# Filled by docker compose run --rm init-secrets for local-only first login. Change the
# bootstrap admin password in /admin/settings after signing in.
PACKMON_ADMIN_INITIAL_PASSWORD=
PACKMON_ADMIN_SESSION_TIMEOUT=8h
PACKMON_ADMIN_IDLE_TIMEOUT=15m

# --- Server Audit Retention ---
# Zero disables pruning for that dataset. Defaults match README/DESIGN.
PACKMON_SCAN_LOG_RETENTION=720h
# full preserves historical scan-log identity metadata; minimal drops client IP
# and API-key identity; none also drops repo name and normalized client version.
PACKMON_SCAN_LOG_IDENTITY_MODE=full
PACKMON_ADMIN_AUDIT_LOG_RETENTION=720h
PACKMON_REFRESH_QUEUE_RETENTION=720h
PACKMON_AUDIT_RETENTION_INTERVAL=24h

# --- Secrets at rest ---
# Filled by docker compose run --rm init-secrets for local-only first start. This remains
# required in production because it encrypts stored feed API keys. Development
# mode may run without it.
PACKMON_ENCRYPTION_KEY=
# Filled by docker compose run --rm init-secrets for local-only first start. Required in
# production because new admin audit digest-chain rows are HMAC-keyed.
PACKMON_ADMIN_AUDIT_HMAC_KEY=

# --- Feed Sync ---
PACKMON_FEED_SYNC_INTERVAL=8h
PACKMON_FEED_SYNC_ON_STARTUP=false
# Host/binary default path. Docker Compose overrides an unset value to the
# image-prepared container directory /data/feeds.
# PACKMON_FEED_DATA_DIR=/tmp/packmon-feeds
# REQUIRED for production feed import writes: send this value in
# X-Packmon-Feed-Import-Secret in addition to the Bearer API key.
# PACKMON_FEED_IMPORT_SECRET=

# --- Feed Enable/Disable ---
# Free baseline feeds stay enabled. Optional account-gated providers stay
# disabled until the matching API key is configured below.
PACKMON_FEED_OSV_ENABLED=true
PACKMON_FEED_GHSA_ENABLED=true
PACKMON_FEED_OPENSSF_ENABLED=true
PACKMON_FEED_VULNCHECK_ENABLED=false
PACKMON_FEED_NVD_ENABLED=true
PACKMON_FEED_CISAKEV_ENABLED=true
PACKMON_FEED_EPSS_ENABLED=true
PACKMON_FEED_ENDOFLIFE_ENABLED=true
PACKMON_FEED_SOCKET_ENABLED=false
PACKMON_FEED_REVERSINGLABS_ENABLED=false

# --- Feed Mode (self = server syncs, external = N8N pushes) ---
# PACKMON_FEED_OSV_MODE=self
# PACKMON_FEED_GHSA_MODE=self
# PACKMON_FEED_OPENSSF_MODE=self
# PACKMON_FEED_VULNCHECK_MODE=self
# PACKMON_FEED_NVD_MODE=self
# PACKMON_FEED_CISAKEV_MODE=self
# PACKMON_FEED_EPSS_MODE=self
# PACKMON_FEED_ENDOFLIFE_MODE=self
# PACKMON_FEED_SOCKET_MODE=self
# ReversingLabs supports self mode only; external is rejected at startup.
# PACKMON_FEED_REVERSINGLABS_MODE=self

# --- Feed API Keys ---
# PACKMON_VULNCHECK_API_KEY=
# PACKMON_VULNCHECK_API_BASE_URL=https://api.vulncheck.com
# PACKMON_NVD_API_KEY=
# PACKMON_ENDOFLIFE_API_BASE_URL=https://endoflife.date/api/v1
# PACKMON_SOCKET_API_KEY=
# PACKMON_SOCKET_API_BASE_URL=https://socket.dev/api/v1
# PACKMON_REVERSINGLABS_API_KEY=
# PACKMON_REVERSINGLABS_API_BASE_URL=https://data.reversinglabs.com/api/oss/community/v2/free
# PACKMON_REVERSINGLABS_LOOKUP_TTL=24h
# Free-plan /find/packages accepts at most 5 packages per request (capped at 5).
# PACKMON_REVERSINGLABS_BATCH_SIZE=5
# Caps demand-driven lookup rows scheduled by one /api/v1/check request.
# PACKMON_REVERSINGLABS_MAX_SCHEDULE_PER_CHECK=100
# Prunes non-finding ReversingLabs cache rows after the configured age.
# PACKMON_REVERSINGLABS_CACHE_RETENTION=168h
# Comma-separated private namespace prefixes to skip before external lookup;
# for example: npm/@internal/,maven/com.acme:
# PACKMON_REVERSINGLABS_EXCLUDED_NAMESPACES=
