{
  "name": "packmon-web-assets",
  "private": true,
  "scripts": {
    "build:web": "npm run build:web:css && npm run build:web:js",
    "build:web:css": "npx tailwindcss -c ./tailwind.config.js -i ./internal/web/static/tailwind.input.css -o ./internal/web/static/tailwind.css --minify",
    "build:web:js": "node ./scripts/build-web-assets.mjs"
  },
  "devDependencies": {
    "htmx.org": "2.0.7",
    "tailwindcss": "3.4.17"
  }
}
