{
  "name": "packmon-web-assets",
  "private": true,
  "scripts": {
    "build:web": "npm run build:web:css && npm run build:web:js",
    "build:web:css": "tailwindcss -c ./tailwind.config.js -i ./internal/web/static/tailwind.input.css -o ./internal/web/static/tailwind.css --minify",
    "build:web:js": "node ./scripts/build-web-assets.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.1",
    "htmx.org": "2.0.10",
    "tailwindcss": "4.3.1"
  }
}
